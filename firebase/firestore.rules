rules_version = '2';

// OBELIX – Firestore-Sicherheitsregeln (Phase 3: Benutzer, Rollen, Zugangscode; Phase 4: Finanzen;
// Phase 5: geplante Ausgaben).
// Konzept: docs/PROJEKTPLAN.md, Abschnitt 7. Es gibt keinen Haushalt: alle registrierten
// Benutzer teilen denselben Datenbestand.
//
// Grundsatz: Alles, was hier nicht ausdrücklich erlaubt ist, ist verboten.
// Fachliche Sammlungen (Finanzen ab Phase 4, Kalender, …) werden erst mit ihrer Phase freigegeben,
// jeweils über isUser() bzw. isAdmin().
//
// Zugriff hat nur, wer ein Benutzerdokument users/{uid} besitzt. Dieses lässt sich nur mit dem
// gültigen Zugangscode anlegen (Vergleich mit config/access.code, das nur der ADMIN lesen kann).
// Der erste ADMIN wird einmalig in der Firebase-Konsole festgelegt (docs/FIREBASE-EINRICHTUNG.md).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }
    function accessPath() {
      return /databases/$(database)/documents/config/access;
    }
    function isUser() {
      return signedIn() && exists(userPath(request.auth.uid));
    }
    function isAdmin() {
      return isUser() && get(userPath(request.auth.uid)).data.role == 'ADMIN';
    }
    function validText(value, maxLength) {
      return value is string && value.size() >= 1 && value.size() <= maxLength;
    }
    // 16 Zeichen ohne I, L, O, 0, 1 (passt zu AccessCode.kt).
    function validCodeFormat(code) {
      return code is string && code.size() == 16 && code.matches('[A-HJKMNP-Z2-9]+');
    }
    // Kalendertag als yyyy-MM-dd (Format; ob der Tag existiert, prüft die App).
    function validDay(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Buchung (Einnahme oder Ausgabe). Betrag in Cent, größer als 0, höchstens 1.000.000,00 EUR
    // (passt zu Money.MAX_CENTS). Einnahmen sind immer SETTLED, Ausgaben brauchen einen Zahler.
    function validBooking(d) {
      return d.keys().hasOnly(['type', 'date', 'amountCents', 'categoryId', 'paidByUid', 'settlement',
                               'description', 'comment', 'settledAt', 'settledBy', 'importRef',
                               'plannedExpenseId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['type', 'date', 'amountCents', 'categoryId', 'settlement', 'description',
                            'comment', 'createdAt', 'createdBy'])
        && d.type in ['INCOME', 'EXPENSE']
        && validDay(d.date)
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000
        && validText(d.categoryId, 100)
        && validText(d.description, 200)
        && d.comment is string && d.comment.size() <= 500
        && d.settlement in ['OPEN', 'SETTLED', 'SPONSORED']
        && (d.type == 'EXPENSE' || d.settlement == 'SETTLED')
        && (!('paidByUid' in d) || validText(d.paidByUid, 128))
        && (d.type == 'INCOME' || 'paidByUid' in d)
        && (!('importRef' in d) || validText(d.importRef, 20))
        && (!('plannedExpenseId' in d) || (validText(d.plannedExpenseId, 128) && d.type == 'EXPENSE'))
        && (!('settledBy' in d) || validText(d.settledBy, 128))
        && (!('settledAt' in d) || d.settledAt is timestamp);
    }

    function transactionPath(bookingId) {
      return /databases/$(database)/documents/transactions/$(bookingId);
    }
    function plannedPath(plannedId) {
      return /databases/$(database)/documents/plannedExpenses/$(plannedId);
    }
    // Geplante Ausgabe (Phase 5). Geschätzter Betrag in Cent (1 bis 1.000.000,00 EUR), Status PLANNED oder
    // PURCHASED; purchasedTransactionId gibt es genau bei PURCHASED (Verweis auf die entstandene Buchung).
    function validPlanned(d) {
      return d.keys().hasOnly(['title', 'estimatedAmountCents', 'plannedDate', 'status', 'priority', 'link',
                               'comment', 'purchasedTransactionId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['title', 'estimatedAmountCents', 'plannedDate', 'status', 'comment', 'createdAt', 'createdBy'])
        && validText(d.title, 200)
        && d.estimatedAmountCents is int && d.estimatedAmountCents > 0 && d.estimatedAmountCents <= 100000000
        && validDay(d.plannedDate)
        && d.status in ['PLANNED', 'PURCHASED']
        && (!('priority' in d) || d.priority in ['LOW', 'MEDIUM', 'HIGH'])
        && (!('link' in d) || (d.link is string && d.link.size() <= 500 && d.link.matches('^https?://[^ ]+$')))
        && d.comment is string && d.comment.size() <= 500
        && ((d.status == 'PURCHASED') == ('purchasedTransactionId' in d))
        && (!('purchasedTransactionId' in d) || validText(d.purchasedTransactionId, 128));
    }

    // =====================================================================
    // users/{uid}: Name und Rolle. Alle Benutzer sehen alle Namen („Bezahlt von").
    // =====================================================================
    match /users/{userId} {
      // Das eigene Dokument darf jeder Angemeldete abfragen, auch wenn es noch nicht existiert:
      // so erkennt die App „noch nicht freigeschaltet" (sonst käme „keine Berechtigung").
      allow get: if isUser() || (signedIn() && userId == request.auth.uid);
      allow list: if isUser();

      // Registrierung: nur für sich selbst, nur als MEMBER, nur mit dem gültigen Zugangscode.
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'accessCode', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'role', 'accessCode', 'createdAt'])
        && validText(request.resource.data.displayName, 50)
        && request.resource.data.role == 'MEMBER'
        && validCodeFormat(request.resource.data.accessCode)
        && exists(accessPath())
        && get(accessPath()).data.code == request.resource.data.accessCode
        && request.resource.data.createdAt == request.time;

      // Eigener Name; ADMIN ändert die Rolle anderer (nie die eigene, damit immer ein ADMIN bleibt).
      allow update: if (
          signedIn() && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && validText(request.resource.data.displayName, 50)
        ) || (
          isAdmin() && userId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['ADMIN', 'MEMBER']
        );

      // ADMIN entfernt Benutzer, nie sich selbst.
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    // =====================================================================
    // config/access: der gemeinsame Zugangscode. Nur ADMIN.
    // =====================================================================
    match /config/access {
      allow get: if isAdmin();

      // code = null sperrt neue Registrierungen.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['code', 'updatedBy', 'updatedAt'])
        && (request.resource.data.code == null || validCodeFormat(request.resource.data.code))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // =====================================================================
    // transactions/{id}: Einnahmen und Ausgaben (Phase 4). Alle Benutzer dürfen lesen, anlegen,
    // ändern und löschen (Entscheidung 4). Audit-Felder werden erzwungen.
    // =====================================================================
    match /transactions/{bookingId} {
      allow get, list: if isUser();

      allow create: if isUser()
        && validBooking(request.resource.data)
        && !('updatedAt' in request.resource.data) && !('updatedBy' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        // Eine Buchung aus einem Kauf entsteht nur zusammen mit der Planung, die im selben Schritt
        // auf PURCHASED gesetzt wird und auf diese Buchung verweist.
        && (!('plannedExpenseId' in request.resource.data) || (
              getAfter(plannedPath(request.resource.data.plannedExpenseId)).data.status == 'PURCHASED'
              && getAfter(plannedPath(request.resource.data.plannedExpenseId)).data.purchasedTransactionId == bookingId));

      allow update: if isUser()
        && validBooking(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('importRef', null) == resource.data.get('importRef', null)
        && request.resource.data.get('plannedExpenseId', null) == resource.data.get('plannedExpenseId', null)
        && 'updatedBy' in request.resource.data && 'updatedAt' in request.resource.data
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if isUser();
    }

    // =====================================================================
    // plannedExpenses/{id}: geplante Ausgaben (Phase 5). Alle Benutzer dürfen lesen, anlegen, ändern
    // und löschen. Der Kauf (PLANNED -> PURCHASED) ist nur zusammen mit der passenden Buchung möglich,
    // eine gekaufte Planung ist nicht mehr änderbar und wird nur wieder geöffnet, wenn ihre Buchung
    // im selben Schritt gelöscht wurde.
    // =====================================================================
    match /plannedExpenses/{plannedId} {
      allow get, list: if isUser();

      allow create: if isUser()
        && validPlanned(request.resource.data)
        && request.resource.data.status == 'PLANNED'
        && !('updatedAt' in request.resource.data) && !('updatedBy' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isUser()
        && validPlanned(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && 'updatedBy' in request.resource.data && 'updatedAt' in request.resource.data
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          // Bearbeiten, solange noch geplant
          (resource.data.status == 'PLANNED' && request.resource.data.status == 'PLANNED')
          // Kauf: die Buchung entsteht im selben Schritt und verweist auf diese Planung
          || (resource.data.status == 'PLANNED' && request.resource.data.status == 'PURCHASED'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'purchasedTransactionId', 'updatedAt', 'updatedBy'])
              && existsAfter(transactionPath(request.resource.data.purchasedTransactionId))
              && getAfter(transactionPath(request.resource.data.purchasedTransactionId)).data.plannedExpenseId == plannedId
              && getAfter(transactionPath(request.resource.data.purchasedTransactionId)).data.type == 'EXPENSE')
          // Wieder öffnen: nur, wenn die Buchung im selben Schritt gelöscht wird
          || (resource.data.status == 'PURCHASED' && request.resource.data.status == 'PLANNED'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'purchasedTransactionId', 'updatedAt', 'updatedBy'])
              && !existsAfter(transactionPath(resource.data.purchasedTransactionId)))
        );

      allow delete: if isUser();
    }

    // =====================================================================
    // categories/{id}: Finanzkategorien. Anlegen darf jeder Benutzer, umbenennen und
    // (de)aktivieren nur ADMIN. Kategorien werden nie gelöscht, damit alte Buchungen gültig bleiben.
    // =====================================================================
    match /categories/{categoryId} {
      allow get, list: if isUser();

      allow create: if isUser()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['name', 'active', 'createdAt', 'createdBy'])
        && validText(request.resource.data.name, 50)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active', 'updatedAt', 'updatedBy'])
        && validText(request.resource.data.name, 50)
        && request.resource.data.active is bool
        && 'updatedBy' in request.resource.data && 'updatedAt' in request.resource.data
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
